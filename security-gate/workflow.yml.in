# Generated by security-gate/render_workflow.py; edit that template and gate.py.
# The driver is embedded in this immutable workflow, NOT imported from the PR.
name: Public PR security

on:
  workflow_call:
    inputs:
      go-targets-json:
        description: '1-8 build targets: [{"goos":"linux","goarch":"amd64","tags":[]}] (CGO disabled)'
        type: string
        default: '[{"goos":"linux","goarch":"amd64","tags":[]}]'

permissions: {}

jobs:
  changes:
    name: Detect merge-base changes
    if: github.event_name == 'pull_request' && github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
    outputs:
      full_run: ${{ steps.changes.outputs.full_run }}
      docs_only: ${{ steps.changes.outputs.docs_only }}
    steps:
      - name: Checkout full history for trusted change detection
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.sha }}
          path: target
          fetch-depth: 0
          persist-credentials: false
          submodules: false
      - name: Detect paths against the merge base (errors fail closed)
        id: changes
        env:
          GATE_MODE: changes
          BASE_SHA: ${{ github.event.pull_request.base.sha }}
          HEAD_SHA: ${{ github.sha }}
        run: &gate-driver |
          python3 -I - "$GATE_MODE" --repo "$GITHUB_WORKSPACE/target" --work "$RUNNER_TEMP/gate-work" --evidence "$RUNNER_TEMP/gate-evidence" --tools "$RUNNER_TEMP/gate-tools" <<'PY'
@DRIVER@
          PY
      - name: Preserve change-detection evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: security-changes
          path: ${{ runner.temp }}/gate-evidence/
          if-no-files-found: error
          retention-days: 5

  inspect:
    name: Inspect tracked PR data
    if: github.event_name == 'pull_request' && github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
    outputs:
      go: ${{ steps.inspect.outputs.go }}
      cargo: ${{ steps.inspect.outputs.cargo }}
      workflows: ${{ steps.inspect.outputs.workflows }}
    steps:
      - name: Checkout PR merge tree as data
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.sha }}
          path: target
          persist-credentials: false
          submodules: false
      - name: Inspect tracked paths and vendored metadata
        id: inspect
        env:
          GATE_MODE: inspect
        run: *gate-driver
      - name: Preserve inspection evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: security-inspection
          path: ${{ runner.temp }}/gate-evidence/
          if-no-files-found: error
          retention-days: 5

  osv:
    name: New OSV vulnerabilities
    needs: [changes, inspect]
    if: github.event_name == 'pull_request' && github.event.repository.private == false && needs.changes.outputs.full_run == 'true'
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: google/osv-scanner-action/.github/workflows/osv-scanner-reusable-pr.yml@b1d267aea5211fa648d9d442fa64b90dbdcbdd36 # v2.7.0
    with:
      fail-on-vuln: true
      upload-sarif: true
      checkout-submodules: false
      runs-on: ubuntu-24.04
      # One immutable empty policy for both comparison scans.
      scan-args: |
        --config=/dev/null
        -r
        ./

  osv-evidence:
    name: Validate OSV comparison evidence
    needs: [changes, osv]
    if: always() && github.event_name == 'pull_request' && github.event.repository.private == false && needs.changes.result == 'success' && needs.changes.outputs.full_run == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      actions: read
    steps:
      - name: Download base scan from this run
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: old-json-results
          path: ${{ runner.temp }}/gate-work/osv-old/
      - name: Download current scan from this run
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: new-json-results
          path: ${{ runner.temp }}/gate-work/osv-new/
      - name: Download diff SARIF from this run
        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: OSV Scanner SARIF file
          path: ${{ runner.temp }}/gate-work/osv-sarif/
      - name: Validate both JSON scans and clean diff SARIF
        env:
          GATE_MODE: osv-evidence
        run: *gate-driver
      - name: Preserve OSV evidence validation
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: security-osv-validation
          path: ${{ runner.temp }}/gate-evidence/
          if-no-files-found: error
          retention-days: 5

  workflow-policy:
    name: Online workflow and action policy
    needs: [changes, inspect]
    if: github.event_name == 'pull_request' && github.event.repository.private == false && needs.changes.outputs.full_run == 'true' && needs.inspect.outputs.workflows == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - name: Checkout PR merge tree as data
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.sha }}
          path: target
          persist-credentials: false
          submodules: false
      - name: Install checksum-pinned workflow scanners
        env:
          GATE_MODE: install
          INSTALL_TOOLS: '["zizmor","pinact"]'
        run: *gate-driver
      - name: Audit all tracked workflows and actions online
        env:
          GATE_MODE: policy
          GITHUB_TOKEN: ${{ github.token }}
        run: *gate-driver
      - name: Preserve workflow-policy evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: security-workflow-policy
          path: ${{ runner.temp }}/gate-evidence/
          if-no-files-found: error
          retention-days: 5

  dependencies:
    name: Go symbols and Rust advisories
    needs: [changes, inspect]
    if: github.event_name == 'pull_request' && github.event.repository.private == false && needs.changes.outputs.full_run == 'true' && (needs.inspect.outputs.go == 'true' || needs.inspect.outputs.cargo == 'true')
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout PR merge tree as data
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          ref: ${{ github.sha }}
          path: target
          persist-credentials: false
          submodules: false
      - name: Install pinned Go toolchain
        if: needs.inspect.outputs.go == 'true'
        uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff # v5.6.0
        with:
          go-version: '1.26.10'
          cache: false
      - name: Install version-pinned govulncheck through the Go checksum database
        if: needs.inspect.outputs.go == 'true'
        run: |
          mkdir -p "$RUNNER_TEMP/gate-tools"
          timeout 300 go install golang.org/x/vuln/cmd/govulncheck@v1.9.0
        env:
          GOBIN: ${{ runner.temp }}/gate-tools
          GOTOOLCHAIN: local
          GOENV: 'off'
          GOFLAGS: ''
          GOSUMDB: sum.golang.org
          GOPROXY: https://proxy.golang.org
          GONOSUMDB: ''
          GOPRIVATE: ''
          GONOPROXY: ''
          GOTELEMETRY: 'off'
      - name: Install pinned Rust toolchain (no PR rust-toolchain files)
        if: needs.inspect.outputs.cargo == 'true'
        run: timeout 300 rustup toolchain install 1.93.0 --profile minimal --no-self-update
      - name: Install checksum-pinned cargo-deny
        if: needs.inspect.outputs.cargo == 'true'
        env:
          GATE_MODE: install
          INSTALL_TOOLS: '["cargo-deny"]'
        run: *gate-driver
      - name: Scan every discovered module and workspace without a workflow token
        env:
          GATE_MODE: dependencies
          GO_TARGETS: ${{ inputs.go-targets-json }}
        run: *gate-driver
      - name: Preserve language-scan evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: security-language-scans
          path: ${{ runner.temp }}/gate-evidence/
          if-no-files-found: error
          retention-days: 5

  security-ok:
    name: security-ok
    needs: [changes, inspect, osv, osv-evidence, workflow-policy, dependencies]
    if: always() && github.event_name == 'pull_request' && github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions: {}
    steps:
      - name: Require complete successful scans (only proven absence may skip)
        env:
          NEEDS_JSON: ${{ toJSON(needs) }}
        run: |
          python3 -I - <<'PY'
          import json, os
          needs = json.loads(os.environ['NEEDS_JSON'])
          assert needs['changes']['result'] == 'success', 'change detection failed or incomplete'
          changed = needs['changes']['outputs']
          assert (changed.get('full_run'), changed.get('docs_only')) in (('true', 'false'), ('false', 'true')), 'change detection incomplete'
          full_run = changed['full_run'] == 'true'
          assert needs['inspect']['result'] == 'success', 'inspection failed or incomplete'
          found = needs['inspect']['outputs']
          assert all(found.get(k) in ('true', 'false') for k in ('go', 'cargo', 'workflows')), 'discovery incomplete'
          expected = {
              'osv': 'success' if full_run else 'skipped',
              'osv-evidence': 'success' if full_run else 'skipped',
              'workflow-policy': 'success' if full_run and found['workflows'] == 'true' else 'skipped',
              'dependencies': 'success' if full_run and 'true' in (found['go'], found['cargo']) else 'skipped',
          }
          for job, result in expected.items():
              assert needs[job]['result'] == result, f'{job}: expected {result}, got {needs[job]["result"]}'
          print('security-ok: complete evidence from every applicable scanner')
          PY

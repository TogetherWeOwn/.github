#[derive(Clone, Copy)]
pub struct SessionKeys<'a> {
    pub primary: &'a [u8],
    pub previous: Option<&'a [u8]>,
}
impl std::fmt::Debug for SessionKeys<'_> {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str("SessionKeys([REDACTED])")
    }
}
#[derive(Debug)]
pub struct Credential<T> {
    pub secret: Secret<T>,
    pub previous: Option<Secret<Vec<u8>>>,
}

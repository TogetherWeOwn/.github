# Documentation example, NOT an installed workflow. Replace the placeholder with
# the reviewed merge commit carrying public-pr-security.yml before adoption.
name: Public PR security
on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
permissions: {}
concurrency:
  group: security-${{ github.event.pull_request.number }}
  cancel-in-progress: true
jobs:
  security:
    if: github.event_name == 'pull_request' && github.event.repository.private == false
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: TogetherWeOwn/.github/.github/workflows/public-pr-security.yml@REPLACE_WITH_REVIEWED_40_CHARACTER_MERGE_SHA
    with:
      go-targets-json: '[{"goos":"linux","goarch":"amd64","tags":["production"]},{"goos":"linux","goarch":"arm64","tags":["production"]}]'
